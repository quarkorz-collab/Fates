{
  "schema_version": 1,
  "profile": "release-balanced-v3",
  "base": [
    {
      "name": "version startup",
      "arguments": ["--version"]
    },
    {
      "name": "self-test",
      "arguments": ["--self-test"]
    },
    {
      "name": "deterministic search",
      "arguments": [
        "520.82418", "--mode", "nearest", "--max-cost", "12", "--beam", "1500", "--pairs",
        "1000000", "--no-stop", "--json"
      ]
    },
    {
      "name": "wide deterministic search",
      "arguments": [
        "2.5063", "--mode", "nearest", "--max-cost", "15", "--beam", "4000", "--pairs",
        "4000000", "--no-stop", "--json"
      ]
    },
    {
      "name": "layered search",
      "arguments": [
        "1.2020569031595943", "--mode", "nearest", "--max-cost", "10", "--beam", "1200",
        "--pairs", "400000", "--no-bidirectional", "--no-stop", "--json"
      ]
    },
    {
      "name": "genetic search",
      "arguments": [
        "21", "--mode", "nearest", "--error-range", "(0,1)", "--digits=", "--constants",
        "pi", "--ops", "+,-,*,/,^,neg,inv,sqrt,ln,sin,cos,tan,sinh", "--max-cost", "12",
        "--beam", "1500", "--pairs", "1000000", "--no-stop", "--genetic",
        "--genetic-population", "512", "--genetic-generations", "8", "--json"
      ]
    },
    {
      "name": "equation search",
      "arguments": [
        "21", "--mode", "nearest", "--max-cost", "10", "--beam", "1000", "--pairs",
        "500000", "--equations", "--equation-search", "wide", "--no-stop", "--json"
      ]
    }
  ],
  "balanced_extra": [
    {
      "name": "pareto with deep and inverse stages",
      "arguments": [
        "0.915965594177219", "--mode", "pareto", "--max-cost", "11", "--beam", "1200",
        "--pairs", "600000", "--results", "30", "--pareto-slots", "3", "--pareto-extra",
        "400", "--deep-rounds", "1", "--deep-beam", "400", "--inverse-depth", "1",
        "--inverse-beam", "32", "--inverse-budget", "200000", "--no-stop", "--json"
      ]
    },
    {
      "name": "wide operator search",
      "arguments": [
        "21", "--mode", "nearest", "--max-cost", "9", "--beam", "1000", "--pairs", "500000",
        "--constants", "pi,e,phi", "--ops",
        "+,-,*,/,^,neg,inv,sqrt,cbrt,sqr,cube,ln,log10,exp,sin,cos,tan,asin,atan,sinh,cosh,tanh,asinh,acosh,atanh,gamma,abs,fact",
        "--no-stop", "--latex"
      ]
    },
    {
      "name": "constrained symbol search",
      "arguments": [
        "24", "--digits", "1234", "--max-literal-len", "1", "--constants", "none", "--ops",
        "+,-,*,/", "--max-cost", "7", "--mode", "nearest", "--symbol-count", "1=1",
        "--symbol-count", "2=1", "--symbol-count", "3=1", "--symbol-count", "4=1",
        "--no-stop", "--latex"
      ]
    },
    {
      "name": "rational approximation with error range",
      "arguments": [
        "3.141592653589793", "--constants", "none", "--digits", "123456789",
        "--max-literal-len", "3", "--max-integer", "999", "--ops", "/", "--max-cost", "7",
        "--mode", "pareto", "--results", "30", "--error-range", "(0,1)", "--no-stop",
        "--latex"
      ]
    },
    {
      "name": "exact value pruning with exploration",
      "arguments": [
        "2.6854520010653064", "--mode", "nearest", "--max-cost", "12", "--beam", "1500",
        "--pairs", "800000", "--value-prune", "exact", "--explore-pairs", "2", "--no-stop",
        "--json"
      ]
    },
    {
      "name": "live reporting",
      "arguments": [
        "520.82418", "--mode", "nearest", "--max-cost", "11", "--beam", "1500", "--pairs",
        "800000", "--live-top", "8", "--live-interval", "0", "--live-json", "--no-stop",
        "--json"
      ]
    },
    {
      "name": "equation search local quality",
      "arguments": [
        "3", "--mode", "nearest", "--max-cost", "11", "--beam", "1000", "--pairs", "500000",
        "--equations", "--equation-quality", "local", "--no-stop", "--json"
      ]
    },
    {
      "name": "equation search exhaustive",
      "arguments": [
        "1.4142135623730951", "--mode", "nearest", "--max-cost", "11", "--beam", "800",
        "--pairs", "400000", "--equations", "--equation-search", "exhaustive", "--no-stop",
        "--json"
      ]
    },
    {
      "name": "portfolio search",
      "arguments": [
        "520.82418", "--mode", "nearest", "--max-cost", "12", "--beam", "1000", "--pairs",
        "500000", "--search-mode", "portfolio", "--pslq-basis", "64", "--pslq-pairs", "256",
        "--egraph-seeds", "128", "--egraph-rounds", "1", "--egraph-nodes", "256",
        "--mcts-iterations", "512", "--mcts-depth", "3", "--mcts-branching", "8",
        "--no-stop", "--json"
      ]
    }
  ]
}
